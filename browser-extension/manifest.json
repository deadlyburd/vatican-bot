{
  "manifest_version": 3,
  "name": "Vatican Ticket Monitor & Auto-Booker",
  "version": "2.0.0",
  "description": "Monitor Vatican Museums tickets and auto-book when available",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://tickets.museivaticani.va/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://tickets.museivaticani.va/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["auto-booker.js", "config.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
